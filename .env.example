# 笺川（FeedLore）2.5.5 可选配置 —— 全新安装**不需要**本文件，直接 up -d 即可；
# 需要改端口 / 走 HTTPS 反代 / 固定账号时，复制为 .env 再改（.env 不要提交）。
# 升级与全新安装的完整步骤见 README.md；本文件对应 docker-compose.v2.release.yml。

# ---- 部署端口 ----
HOST_PORT=3210

# ---- PostgreSQL ----
# 全新安装用默认值即可；已有站点升级时必须沿用原来的库名与 PG_PASSWORD
PG_DB=feedlore_v2
PG_USER=feedlore
PG_PASSWORD=feedlore
# 目标库名，与 PG_DB 保持一致；改库名时两个变量一起改
V2_DB_NAME=feedlore_v2

# ---- 镜像 ----
# 钉版本号（安全）；想跟随 latest 滚动升级改成 ghcr.io/chensnails/feedlore:latest
V2_IMAGE=ghcr.io/chensnails/feedlore:2.5.5

# ---- MCP 接口（可选）----
# 外部 AI 客户端经 /mcp 调用只读工具（频道 / 文章 / 日报）。鉴权用「设置 → MCP 接口」
# 里创建的 Bearer 令牌（flm_ 前缀），与登录会话完全独立。默认开启 —— 没有令牌时端点
# 只会 401，无任何风险；设为 0 可整体关闭。
#MCP_ENABLED=1

# ---- 鉴权（都可以留空）----
# 会话签名密钥：留空则首次启动自动生成并保存进 v2 库；一旦有值就不要再改，
# 改掉会让所有人当前登录态失效
AUTH_SECRET=
# 用户实际访问的地址（带协议与端口）。留空则按请求 Host 做同源校验；
# 多域名 / 反代改写 Host 时建议显式填写，例如 http://192.168.1.10:3210
AUTH_BASE_URL=
# 反代域名与 IP 两种访问方式都要用时，逗号分隔列出
AUTH_TRUSTED_ORIGINS=
# 纯 HTTP 必须为 0；前面是 HTTPS 反代时才设 1
AUTH_SECURE_COOKIES=0
# 公开注册默认关闭（只允许管理员在「设置 → 账号」加人）。确实要开放自助注册时设 1；
# 对外网开放的实例慎用 —— 等于任何拿到网址的人都能建号并消耗带宽与模型额度
#ALLOW_SIGNUP=1

# ---- 初始管理员（可选）----
# 空站点首次启动自动创建 admin，初始密码固定为 Admin2026（公开值，所以登录后强制改密：
# 未改密前除改密接口外的请求一律 403）。想换掉这枚初始口令才填 ADMIN_PASS，
# 同样要求首次登录后修改；创建之后改这里无效，请到「设置 → 账号」修改。
ADMIN_USER=admin
ADMIN_PASS=

# ---- 一键更新 ----
# Watchtower HTTP API 的共享密钥；只在容器网络内使用，默认 feedlore-update
WATCHTOWER_HTTP_API_TOKEN=feedlore-update

# ---- 采集默认值（仅新库首次落库时生效，之后以页面「设置 → 数据源」为准）----
REFRESH_MINUTES=30
KEEP_PER_FEED=300
# 条目最长保留天数（0 = 不限）
KEEP_DAYS=90
# 抓取与模型调用统一走 HTTP(S) 代理时填写（例如 http://172.17.0.1:7890）；
# 只支持 http/https（不支持 socks）。同样只在首次落库时作为默认值，之后以页面为准
PROXY_URL=

# ---- 出网安全 / 反代 ----
# 允许访问内网地址（自建 FreshRSS / 本机 Ollama 等）时设 1
ALLOW_PRIVATE_HOSTS=
# 登录限流取真实 IP：默认自动判断，特殊拓扑可强制 1 / 0
TRUST_PROXY=

# ---- 启动严格模式（V3.0 新增，可留空）----
# 默认（留空或 0）：配置格式错误、数据库连不上会直接拒绝启动并打印原因；
# 结构迁移失败只告警继续（兼容无 DDL 权限的外部托管数据库）。
# 设 1：结构迁移失败也拒绝启动，适合自己掌控数据库、要求「启动即结构一致」的部署。
#STRICT_BOOT=1
