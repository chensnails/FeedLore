# 笺川（FeedLore）2.x 可选配置 —— 全新安装**不需要**本文件，直接 up -d 即可；
# 需要改端口 / 复用 1.x 密码 / 走 HTTPS 反代时，复制为 .env 再改（.env 不要提交）。
# 升级与全新安装的完整步骤见 UPGRADE-v2.md；本文件对应 docker-compose.v2.release.yml。

# ---- 部署端口 ----
# 宿主机映射端口（1.x 默认 3210，保持不变 Watchtower 才能无缝接管）
HOST_PORT=3210

# ---- PostgreSQL ----
# 全新安装用默认值即可；已有 1.x 站点升级时必须填原来的 PG_PASSWORD
PG_DB=feedlore
PG_USER=feedlore
PG_PASSWORD=feedlore
# 2.x 使用同一实例里的新库，1.x 的库全程只读
V2_DB_NAME=feedlore_v2

# ---- 镜像 ----
# 钉版本号（安全）；想跟随 latest 滚动升级改成 ghcr.io/chensnails/feedlore:latest
V2_IMAGE=ghcr.io/chensnails/feedlore:2.4.2

# ---- MCP 接口（可选）----
# 外部 AI 客户端经 /mcp 调用只读工具（频道 / 文章 / 日报）。鉴权用「设置 → MCP 接口」
# 里创建的 Bearer 令牌（flm_ 前缀），与登录会话完全独立。默认开启 —— 没有令牌时端点
# 只会 401，无任何风险；设为 0 可整体关闭。
#MCP_ENABLED=1

# ---- 鉴权（都可以留空）----
# 会话签名密钥：留空则首次启动自动生成并保存进 v2 库；一旦有值就不要再改，
# 改掉会让所有人当前登录态失效
AUTH_SECRET=
# 用户实际访问的地址（带协议与端口）。留空则按请求 Host 做同源校验；
# 多域名 / 反代改写 Host 时建议显式填写，例如 http://192.168.1.10:3210
AUTH_BASE_URL=
# 反代域名与 IP 两种访问方式都要用时，逗号分隔列出
AUTH_TRUSTED_ORIGINS=
# 纯 HTTP 必须为 0；前面是 HTTPS 反代时才设 1
AUTH_SECURE_COOKIES=0

# ---- 初始管理员（可选）----
# 空站点首次启动自动创建 admin；不填 ADMIN_PASS 会生成一次性随机口令，只在
# 启动日志打印一次。想自己指定初始口令才填（创建后再改无效，请到「设置 → 账号」修改）
ADMIN_USER=admin
ADMIN_PASS=

# ---- 一键更新 ----
# Watchtower HTTP API 的共享密钥；只在容器网络内使用，默认 feedlore-update
WATCHTOWER_HTTP_API_TOKEN=feedlore-update

# ---- 采集默认值（仅新库首次落库时生效，之后以页面「设置 → 数据源」为准）----
REFRESH_MINUTES=30
KEEP_PER_FEED=300
# 条目最长保留天数（0 = 不限）
KEEP_DAYS=90

# ---- 升级（可选）----
# 设 1 跳过 PG 内的 <库名>_backup 快照（快照失败本身只告警，不阻断升级）
UPGRADE_SKIP_BACKUP=
# 设 1 跳过图片缓存迁移（v2 会按需回源重新缓存）
UPGRADE_SKIP_IMAGE_CACHE=

# ---- 出网安全 / 反代（与 1.x 同名参数，直接沿用）----
# 允许访问内网地址（自建 FreshRSS / 本机 Ollama 等）时设 1
ALLOW_PRIVATE_HOSTS=
# 登录限流取真实 IP：默认自动判断，特殊拓扑可强制 1 / 0
TRUST_PROXY=
