# 笺川（Feedlore）部署配置 —— 复制为 .env 后按需修改（.env 不要提交到版本库）
#
# 源码构建部署用 docker-compose.yml；镜像部署（ghcr + Watchtower 自动更新）
# 用 docker-compose.release.yml，需额外填下面「一键更新」段的 token。

# ---- 部署端口 ----
# 宿主机映射端口
HOST_PORT=3210

# ---- 专用 PostgreSQL（compose 内会起一个 postgres:18-alpine）----
# 首次启动自动创建该库与用户；PG_PASSWORD 必填，请改成强密码
PG_DB=feedlore
PG_USER=feedlore
PG_PASSWORD=change-me-to-a-strong-password

# ---- 初始订阅源（仅当订阅表为空时生效，逗号分隔）----
# 留空即可，启动后在页面「设置 → 数据源」里添加
# 例：SEED_FEEDS=https://rsshub.app/telegram/channel/example,https://example.com/feed.xml
SEED_FEEDS=

# ---- RSS 抓取（仅首次写入数据库时生效，之后请在页面「设置 → 数据源」调整）----
# 自动抓取间隔（分钟，5~1440）；单个频道可在「设置 → 数据源」里单独覆盖
REFRESH_MINUTES=30
# 每个频道保留多少条历史条目（20~5000）
KEEP_PER_FEED=300
# 条目最长保留多少天（0 = 不限时长，只按上面的条数保留；1095 = 3 年）
KEEP_DAYS=0
# 打开的网页每隔多少分钟自动重新读取列表（0 = 关闭，不触发服务端抓取）
AUTO_REFRESH_MINUTES=0
# 频道连续抓取失败多少次后自动停用采集（2~20；重试成功会自动恢复）
FEED_FAIL_LIMIT=5

# ---- 图片缓存（仅首次写入数据库时生效，之后请在页面「设置 → 数据源 → 采集参数」调整）----
# 图片回源窗口（天，1~365）：窗口内的重复访问不再请求上游，超过窗口仍先返回旧图、后台静默刷新
IMG_TTL_DAYS=7
# 图片缓存在数据库保留多少天（1~3650），到期由每日清理删除
IMG_KEEP_DAYS=90
# 图片最长边（320~4096 px，等比缩放不放大）
IMG_MAX_DIM=1280
# WebP 压缩质量（30~100）
IMG_WEBP_QUALITY=78

# ---- 大模型 / 每日简报 ----
# 这两项没有环境变量：从 v1.4.0 起完全跟随账号，每人都在自己的「设置 → 模型」「设置 → 日报」里填。
# 落库前 API Key 会自动加密（AES-256-GCM），页面只显示掩码，不回显明文。

# ---- 初始账号（仅首次写入数据库时生效，之后请在页面「设置 → 账号」修改）----
ADMIN_USER=admin
ADMIN_PASS=admin

# ---- 一键更新（仅 docker-compose.release.yml 镜像模式需要）----
# Watchtower HTTP API 的共享密钥：页面「设置 → 关于 → 一键更新」经后端转发触发，
# app 容器只与同网络的 watchtower 通信，不触碰宿主机。
# 生成一个随机串填入（如 openssl rand -hex 24）；源码构建模式留空即可。
WATCHTOWER_HTTP_API_TOKEN=
