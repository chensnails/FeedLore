{
  "name": "@feedlore/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "upgrade:v1": "tsx scripts/upgrade.ts"
  },
  "dependencies": {
    "@feedlore/ai": "workspace:*",
    "@feedlore/auth": "workspace:*",
    "@feedlore/contract": "workspace:*",
    "@feedlore/db": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "htmlparser2": "^10.1.0",
    "linkedom": "^0.18.14",
    "safe-regex2": "^5.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "undici": "6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
