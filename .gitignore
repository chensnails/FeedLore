# 依赖
node_modules/

# Vite 构建产物（镜像内构建，不入库）
dist/
.vite/

# 环境变量（含数据库密码、模型 Key 等密钥，绝不入库）
.env
.env.local
.env.*.local

# 本地开发辅助（体积大，部署不需要）
/screenshots/
.workbuddy-ai/
# WorkBuddy 本地记忆/配置（可能含服务器信息，绝不入库）
.workbuddy/

# 部署 / 备份产物
*.tgz
*.tar.gz
backups/
public-backup-*.tgz

# 系统 / 日志
.DS_Store
*.log
npm-debug.log*

# UI 回归测试的 esbuild 产物
tests/ui/.build/

# 本地临时脚本产物
.build/

# docs 目录：产品文档、开发日志、发布稿等只留本地，不上 GitHub；截图除外（README 引用）
/docs/*
!/docs/screenshots/

# 审计/验证临时产物（CDP 截图、Edge 临时配置）
.audit-shots/
.audit-*
